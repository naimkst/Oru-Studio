NEXT_PUBLIC_SITE_URL=https://orustudio.com
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=

# Contact form SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=

# Automated blog generation.
OPENAI_API_KEY=
OPENAI_BLOG_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_FORMAT=webp
OPENAI_IMAGE_QUALITY=medium
OPENAI_THUMBNAIL_SIZE=1536x1024
OPENAI_CONTENT_IMAGE_SIZE=1536x1024
BLOG_INSIDE_IMAGE_COUNT=1
BLOG_CRON_SECRET=replace-with-a-long-random-secret

# Blog admin login. Change these before deploying.
BLOG_ADMIN_USERNAME=admin
BLOG_ADMIN_PASSWORD=replace-with-a-strong-password
BLOG_SESSION_SECRET=replace-with-a-long-random-secret
BLOG_DB_PATH=/var/www/orustudio.com/data/blog.sqlite
