{
  "name": "oru-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3387",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3387",
    "start:production": "sh scripts/start-production.sh",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 reload ecosystem.config.cjs --only oru-studio --update-env || pm2 start ecosystem.config.cjs --update-env",
    "pm2:logs": "pm2 logs oru-studio",
    "health": "sh scripts/health-check.sh",
    "deploy:production": "npm run build && npm run pm2:restart && npm run health",
    "lint": "next lint"
  },
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@mui/material": "^5.11.0",
    "@mui/styled-engine-sc": "^5.11.0",
    "@studio-freight/react-lenis": "^0.0.47",
    "better-sqlite3": "^13.0.3",
    "bootstrap": "^5.3.3",
    "gsap": "^3.12.5",
    "next": "15.0.1",
    "nodemailer": "^9.0.4",
    "react": "19.0.0-rc-69d4b800-20241021",
    "react-awesome-reveal": "^4.2.14",
    "react-dom": "19.0.0-rc-69d4b800-20241021",
    "react-modal-video": "^2.0.2",
    "react-slick": "^0.30.3",
    "sass": "^1.80.4",
    "simple-react-validator": "^1.6.2",
    "swiper": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5"
  }
}
